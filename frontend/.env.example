# Main Frontend Production Environment Variables Template (vakancy.in)
# Note: Frontend Vite variables MUST NEVER contain secret API keys or database credentials!

# API Base URL (Leave empty or set to /api for relative reverse proxy routing, or specify full API origin)
VITE_API_BASE_URL=/api

# Canonical Admin App Destination URL (Defaults to https://admin.vakancy.in in production)
VITE_ADMIN_APP_URL=https://admin.vakancy.in

# Google Identity Services (GIS) Web Client ID
VITE_GOOGLE_CLIENT_ID=15631312508-0r23i2q9aaor4teum3sehvk0j65v3qi9.apps.googleusercontent.com

