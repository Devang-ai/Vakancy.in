{
  "name": "vakancy-backend",
  "version": "1.0.0",
  "description": "Production-ready Recruitment & Job Portal MVP Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:security": "node --test tests/phase1_security_unit.test.js",
    "test:phase2:safe": "node --test tests/phase2_database_safety.test.js tests/phase2_authorization_unit.test.js",
    "test:phase3:safe": "node --test tests/phase3_workflow_unit.test.js",
    "migrate": "node database/runMigrations.js --app",
    "migrate:test": "node database/runMigrations.js --test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.4",
    "resend": "^3.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "puppeteer-core": "^25.14.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "follow-redirects": "1.16.1",
    "brace-expansion": "2.1.7"
  }
