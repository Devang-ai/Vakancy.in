# Backend Production Environment Variables Template
PORT=5000
NODE_ENV=production
TRUST_PROXY=true

# Allowed CORS Origins (comma-separated, without quotes or brackets)
ALLOWED_ORIGINS=https://vakancy.in,https://www.vakancy.in,https://admin.vakancy.in
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_PRODUCTION_DB_USER
DB_PASSWORD=YOUR_PRODUCTION_DB_PASSWORD
DB_NAME=vakancy_db

# Security & Session
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration (Server-Side Only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Email Notification Service (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
FROM_EMAIL=notifications@vakancy.in
INTERNAL_RECRUITMENT_EMAIL=admissions@vakancy.in

# Payment Gateway (Razorpay) - retained for future work; payment routes are disabled in code
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Centralized Cloudinary Media & Document Storage (Server-Side Only)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Hostinger SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@vakancy.in
SMTP_PASSWORD=YOUR_HOSTINGER_SMTP_PASSWORD
EMAIL_FROM="Vakancy Support <support@vakancy.in>"
FRONTEND_URL=https://vakancy.in
