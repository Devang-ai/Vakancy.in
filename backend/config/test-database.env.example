# Copy these names into a secret-managed test environment. Never commit values.
NODE_ENV=test
DATABASE_TEST_MODE=isolated-mysql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=vakancy_test_runner
TEST_DB_PASSWORD=<test-only-secret>
TEST_DB_NAME=vakancy_test_local
# Required only by an explicitly reviewed destructive lifecycle operation.
TEST_DB_RESET_ACK=I_UNDERSTAND_THIS_DATABASE_IS_DISPOSABLE
