# Vakancy.in Platform Root Deployment Environment Variables Template

# Node Environment & Port
NODE_ENV=production
PORT=5000
TRUST_PROXY=true
APP_URL=https://vakancy.in

# Domain CORS Origins
ALLOWED_ORIGINS=https://vakancy.in,https://www.vakancy.in,https://admin.vakancy.in

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_PRODUCTION_DB_USER
DB_PASSWORD=YOUR_PRODUCTION_DB_PASSWORD
DB_NAME=vakancy_db

# Security & Sessions
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Server-Side Integrations
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
FROM_EMAIL=notifications@vakancy.in
INTERNAL_RECRUITMENT_EMAIL=admissions@vakancy.in

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Centralized Cloudinary Media & Document Storage
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Frontend Environment Variables (Vite client-side)
VITE_API_URL=/api
VITE_API_BASE_URL=/api
